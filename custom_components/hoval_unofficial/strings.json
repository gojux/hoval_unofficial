        "title": "Installation",
        "description": "Without a tick, the integration neither creates entities for that part of the installation nor reads or writes its values.",
        "data": {
          "heat_pump_controller": "Heat pump controller",
          "heating_circuit_2_present": "Heating circuit 2 present",
          "heating_circuit_3_present": "Heating circuit 3 present",
          "dhw_present": "Domestic hot water present"
        },
        "data_description": {
          "heat_pump_controller": "Choose the controller that matches your heat pump model; setup suggested one based on the energy meters. Without energy meters (ECR461), the sensors for energy, power, COP and SPF are disabled; switching back enables them again.",
          "dhw_present": "After changes to the hot water tank, save once to detect the hot water sensors again."
        }
      },
      "circuit": {
        "title": "Heating circuit {circuit}",
        "description": "Current control strategy: {strategy}\nRoom temperature on the controller: {room_temperature} °C (0 means no value)",
        "data": {
          "current_temp_source": "Room temperature source",
          "current_temp_entity_id": "Room temperature entity",
          "room_influence": "Include room sensor in control strategy",
          "flow_setpoint_raise_min": "Lowest flow setpoint raise",
          "flow_setpoint_raise_max": "Highest flow setpoint raise"
        },
        "data_description": {
          "current_temp_entity_id": "Only needed for the sources that use a Home Assistant entity.",
          "room_influence": "Switches to the control strategy with room influence. Needs a room temperature (room sensor or a sent entity). The flow temperature is only corrected if \"Room temperature compensation\" (03-007) on the operating module is above 0.",
          "flow_setpoint_raise_min": "Currently on the controller: {current_raise} K. Lower bound of the raise, also for its automatic adjustment.",
          "flow_setpoint_raise_max": "Upper bound of the raise, also for its automatic adjustment."
        }
      },
      "confirm_risks": {
        "title": "Heating circuit {circuit}: please read before turning this on",
        "description": "The room temperature then directly affects how the heat pump controls this heating circuit:\n\n- A room temperature below the setpoint raises the flow temperature, a few kelvin can be enough to reach the maximum flow temperature.\n- A room temperature above the setpoint can switch the heating circuit off.\n- If the entity has no usable value for 5 minutes (unavailable, outside 5–40 °C, or no report for 2 hours), the room setpoint is sent instead, so the room temperature has no effect until the entity is usable again.\n- If Home Assistant itself is down, the controller keeps working with the last value it received.\n- How strongly the controller reacts depends on the parameter \"Room temperature compensation\" (03-007) on the operating module. For underfloor heating, Hoval recommends no more than 4.\n\nClose this dialog to change nothing.",
        "data": {
          "accept_risks": "I have read these notes and want to continue"
        }
      },
      "experimental": {
        "title": "Experimental functions",
        "description": "These functions are still being tested on few installations. They can make the heat pump run less efficiently or the rooms get too cold or too warm, so keep an eye on them after turning one on. Some of them are then set up in a heating circuit's form.",
        "data": {
          "experimental_cooling": "Cooling",
          "experimental_room_influence": "Room influence",
          "experimental_flow_setpoint_raise": "Flow setpoint raise",
          "experimental_constant_control": "Constant control (strategy 3)"
        },
        "data_description": {
          "experimental_cooling": "Enables cooling for heating circuits whose control strategy includes it. Only turn on if the installation can cool.",
          "experimental_room_influence": "Lets you switch room influence on or off per heating circuit and send a room temperature from Home Assistant to the controller.",
          "experimental_flow_setpoint_raise": "Lets you raise the heat pump's flow temperature above the heating circuit's, for heating circuit 1 with a suggestion and automatic adjustment.",
          "experimental_constant_control": "Controls heating circuits on constant control through a heating / off / cooling select and fixed flow temperatures."
        }
      },
      "confirm_cooling_off": {
        "title": "Turn cooling off",
        "description": "Heating circuit(s) {circuits} currently cool. Saving turns their cooling off and checks it; only then is it saved.\n\nClose this dialog to change nothing."
      },
      "confirm_room_influence_off": {
        "title": "Turn room influence off",
        "description": "For heating circuit(s) {circuits}, the control strategy is set back to its value from before room influence and checked; only then is it saved.\n\nClose this dialog to change nothing."
      }
